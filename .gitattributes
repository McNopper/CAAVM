# Normalize line endings across platforms (CAAVM runs on mixed desktops).
* text=auto eol=lf

# Keep Windows scripts CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary assets — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ico   binary
