<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

  <extension point="org.eclipse.ui.views">
    <view
          id="com.opencode.ide.chat.views.ChatView"
          name="Chat"
          icon="icons/chat.png"
          allowMultiple="true"
          category="com.opencode.ide.ui"
          class="com.opencode.ide.chat.views.ChatView"/>
  </extension>

  <extension point="org.eclipse.ui.commands">
    <command
          id="com.opencode.ide.chat.openChat"
          name="Open Chat"
          description="Open a chat window - with a model (new session) or a sessionId (resume)">
      <commandParameter
            id="com.opencode.ide.chat.openChat.providerId"
            name="Provider"
            optional="true"/>
      <commandParameter
            id="com.opencode.ide.chat.openChat.modelId"
            name="Model"
            optional="true"/>
      <commandParameter
            id="com.opencode.ide.chat.openChat.sessionId"
            name="Session"
            optional="true"/>
    </command>
  </extension>

  <extension point="org.eclipse.ui.handlers">
    <handler
          commandId="com.opencode.ide.chat.openChat"
          class="com.opencode.ide.chat.handlers.OpenChatHandler"/>
  </extension>

  <extension point="org.eclipse.ui.bindings">
    <key
          commandId="com.opencode.ide.chat.openChat"
          schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
          sequence="CTRL+ALT+SHIFT+C"/>
  </extension>

</plugin>
